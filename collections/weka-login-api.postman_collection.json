          "name": "Log in to the cluster",
          "request": {
            "name": "Log in to the cluster",
            "description": {
              "content": "Authenticates and grants access to the cluster using valid credentials.<br> Securely saves user credentials in the user's home directory upon successful login.",
              "type": "text/plain"
            },
