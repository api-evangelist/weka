          "name": "Get access token",
          "request": {
            "name": "Get access token",
            "description": {
              "content": "Obtains a new access token using an existing refresh token.<br> The system creates an authentication token file and saves it in `~/.weka/auth-token.json`.<br> The token file contains both the access token and the refresh token.",
              "type": "text/plain"
            },
            "url": {
