{
  "opencollection": "1.0.0",
  "info": {
    "name": "@weka-api Active Directory Data Service API",
    "version": "5.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "DataService",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Data Service features",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v2/dataService/features"
          },
          "docs": "Lists the background tasks, such as quota coloring, managed by the Data Services container."
        }
      ]
    }
  ],
  "bundled": true
}